        LocalModel --> LocalMySQL
        AppConfigModel --> LocalMySQL
    end

    %% Edge Functions
    subgraph Supabase Edge Functions
        DeletionEF["request-account-deletion"]
        AppVersionEF["manage-app-version"]
    end

    %% Client and Database Interactions
    RNApp -- "Submits Reports via API" --> SupabaseDB
    
    SBC -- "HTTP REST Request (cURL)" --> SupabaseDB
    SBC -- "Dynamically falls back if no .env config" --> LocalMockDB

